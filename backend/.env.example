# Telegram BotFather'dan olingan bot tokeni
BOT_TOKEN=Tokeningizni shu yerga yozing (masalan: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)

# Ma'lumotlar bazasi (SQLite bilan boshlash oson, keyin Postgresga o'tkazish mumkin)
DATABASE_URL=sqlite:///./nozanin.db
# Postgres misoli:
# DATABASE_URL=postgresql://user:password@db:5432/nozanin

# Mini App joylashgan https manzil (frontend deploy qilingandan keyin)
WEBAPP_URL=https://your-domain.com

# Boshlang'ich adminlar Telegram ID lari, vergul bilan (masalan: 111111111,222222222)
ADMIN_TELEGRAM_IDS=111111111

# Mahsulot postlari yuboriladigan kanal/gruppalar (vergul bilan ajrating: -1001234567890,@kanal)
PRODUCT_CHAT_IDS=

# Kunlik hisobot yuboriladigan vaqt (24 soatlik format, Asia/Tashkent bo'yicha)
DAILY_REPORT_HOUR=21
DAILY_REPORT_MINUTE=0
TIMEZONE=Asia/Tashkent

# CORS (frontend domenini yozing, hammaga ruxsat uchun *)
CORS_ORIGINS=*

# PythonAnywhere webhook uchun ixtiyoriy himoya kaliti
WEBHOOK_SECRET=change-this-secret
